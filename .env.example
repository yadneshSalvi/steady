# Copy to .env.local. Keep all values server-side and untracked.
# Use a dedicated development database, separate from production Neon.
DATABASE_URL=postgres://localhost:5432/steady_dev
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=

# Explicitly enable fresh paid previews after an integration check.
YOUCAM_API_KEY=
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com
YOUCAM_LIVE_ENABLED=false
YOUCAM_BALANCE_FLOOR=200
YOUCAM_DAILY_JOB_LIMIT=12
# Per browser, per database day. This includes every personal studio.
YOUCAM_SESSION_JOB_LIMIT=6
YOUCAM_IP_DAILY_JOB_LIMIT=8
# Additional ceiling for single Light previews requested during application.
YOUCAM_ADAPTATION_DAILY_JOB_LIMIT=2

# Optional selected-still interpretation; separate user consent covers both.
GEMINI_API_KEY=
OPENAI_API_KEY=
VISION_PRIMARY_PROVIDER=gemini
GEMINI_VISION_MODEL=gemini-4-argon
OPENAI_VISION_MODEL=gpt-6-astra
VISION_REQUEST_TIMEOUT_MS=35000
AI_HOURLY_REQUEST_LIMIT=120
AI_OWNER_HOURLY_REQUEST_LIMIT=60
AI_IP_HOURLY_REQUEST_LIMIT=30

# Optional short-clip voice commands; never expose this to the browser.
DEEPGRAM_API_KEY=
VOICE_HOURLY_REQUEST_LIMIT=720
VOICE_OWNER_HOURLY_REQUEST_LIMIT=360
VOICE_IP_HOURLY_REQUEST_LIMIT=180
